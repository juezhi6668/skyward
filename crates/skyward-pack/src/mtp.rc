# File transfer: an MTP function beside adb, for a recovery that serves the
# function itself. The function is made once at boot, next to the adb one
# the base already sets up, and the functionfs is mounted only once the
# function behind it exists -- the kernel refuses it the other way round.
# The port is re-bound for file transfer only once this program has written
# the descriptors (sys.usb.ffs.mtp.ready) and adbd has its own function
# ready too (sys.usb.ffs.ready), which is what the base's adb rules wait for
# as well.
on boot
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/mtp 0770 root root
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=0,gid=0
    # Nothing is bound for file transfer yet, and the port is asked for a
    # binding once per configuration rather than once per property change.
    setprop sys.usb.mtp.bound 0

on property:sys.usb.config=mtp,adb
    start adbd

# **The port is bound once per configuration, not once per property
# change.** The cable coming out sets one of these properties again a tenth
# of a second later, and binding the port again there takes the functions
# away from the programs that have them open: file transfer then answers
# "no such device" to everything, and the cable going back in changes
# nothing. Asking for the port again goes through sys.usb.config=none, which
# is what clears the word below, so the file-transfer switch still binds it
# as it did.
on property:sys.usb.config=none
    setprop sys.usb.mtp.bound 0

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.mtp.bound=0
    # The ids this computer already takes for MTP with adb on this phone:
    # the base's own. Windows binds by VID:PID, and Google's single-function
    # ids each cost one of the two -- 0x4EE2 gives the ADB interface its
    # bootloader driver, 0x4EE7 claims the composite as one ADB device and
    # never enumerates the picture-transfer interface at all.
    write /config/usb_gadget/g1/idVendor 0x2717
    write /config/usb_gadget/g1/idProduct 0xFF48
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}
    setprop sys.usb.mtp.bound 1
